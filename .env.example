# Copy this file to ".env.local" for running on your own computer.
# On Vercel, enter the same names under Project → Settings → Environment Variables.

# Postgres connection string (Neon gives you this; on Vercel the Neon integration fills it in for you).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for the /admin page. Use something long that you don't use anywhere else.
ADMIN_PASSWORD=change-me-to-something-long

# Random secret used to sign voter cookies and hash IP addresses. At least 32 characters.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it during the conference: that would make every device look like a new voter.
COOKIE_SECRET=replace-with-64-random-hex-characters

# Optional: the public address the QR code points to. If left out, the admin page uses
# whatever address you opened it from. Set it once you know your final address.
# NEXT_PUBLIC_SITE_URL=https://marist-peoples-choice.vercel.app

# Optional: max ballots per 10 minutes from one network (IP address). Default 300.
# VOTE_RATE_LIMIT=300
